# Copy this file to .env and fill in keys as needed.
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=

# Provider-neutral configuration used by chapter notebooks.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_STRUCTURED_MODE=json_object
LLM_EXTRA_BODY_JSON=
LLM_PARALLEL_TOOL_CALLS=
LLM_MAX_TOOL_ROUNDS=4

# Live model calls stay disabled during normal notebook validation.
RUN_LIVE_LLM=0
RUN_LIVE_EVAL=0
RUN_LIVE_TOOL_CALLING=0
RUN_LIVE_EMBEDDING=0
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b

# Chapter 7: Context / Memory
RUN_LOCAL_LLM=0
LLAMA_CPP_SERVER_URL=http://127.0.0.1:8081
